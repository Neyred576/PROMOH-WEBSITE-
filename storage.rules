rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for portfolio, profile photos, and shared chat files
    match /{allPaths=**} {
      allow read: if true;
      // Allow upload only if authenticated and file size is strictly under 10MB
      allow write: if request.auth != null && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
